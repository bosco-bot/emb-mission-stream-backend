{
    "name": "horizonsplus/collector-laravel",
    "description": "Collecteur HorizonsPlus pour projets Laravel — expose /api/monitoring/health",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "HorizonsPlus"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "HorizonsPlus\\CollectorLaravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HorizonsPlus\\CollectorLaravel\\HorizonsCollectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
